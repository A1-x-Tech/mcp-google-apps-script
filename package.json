{
  "name": "mcp-google-apps-script",
  "version": "0.1.0",
  "description": "MCP server for the Google Apps Script API — create script projects, read and update code files, manage versions and deployments, run functions and inspect executions. For Claude, Cursor, Codex and other AI clients.",
  "mcpName": "io.github.A1-x-Tech/mcp-google-apps-script",
  "type": "module",
  "bin": {
    "mcp-google-apps-script": "dist/index.js"
  },
  "files": [
    "dist",
    "test"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "smoke": "node --import tsx src/smoke.ts",
    "test": "npm run test:src && npm run test:dist",
    "test:src": "node --import tsx --test $(find src -name '*.test.ts')",
    "test:dist": "npm run build && node --test test/dist-smoke.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google",
    "google-apps-script",
    "apps-script",
    "automation",
    "scripting",
    "claude",
    "cursor",
    "codex"
  ],
  "license": "MIT",
  "author": "gistrec <gistrec@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A1-x-Tech/mcp-google-apps-script.git"
  },
  "homepage": "https://github.com/A1-x-Tech/mcp-google-apps-script#readme",
  "bugs": {
    "url": "https://github.com/A1-x-Tech/mcp-google-apps-script/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
